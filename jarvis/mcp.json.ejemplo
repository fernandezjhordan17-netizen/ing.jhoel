{
  "mcpServers": {
    "jarvis-bim": {
      "command": "jarvis-mcp/.venv/Scripts/jarvis-bim-mcp.exe",
      "args": [],
      "env": {
        "JARVIS_BOVEDA": "JARVIS-BIM"
      }
    },
    "excel": {
      "command": "uvx",
      "args": [
        "excel-mcp-server",
        "stdio"
      ]
    }
  }
}